-- engines/sqlserver-to-postgresql/checks/reconcile.sql.tmpl
-- Equivalence checks for the validation phase. TEMPLATES — the validation skill
-- substitutes {schema}, {table}, {column}, {columns}, {key}, {n} per object.
-- Run the SQL SERVER block against the source and the POSTGRES block against the
-- target (via the dbmig drivers — pytds / psycopg), then diff the results.

-- ============================================================
-- 1. ROW COUNT  (must match exactly)
-- ============================================================
-- SQL SERVER:
SELECT COUNT(*) FROM [{schema}].[{table}];
-- POSTGRES:
SELECT COUNT(*) FROM "{schema}"."{table}";

-- ============================================================
-- 2. COLUMN CHECKSUM  (order-independent aggregate hash per column)
-- ============================================================
-- SQL SERVER (HASHBYTES over the column cast to nvarchar; summed via CHECKSUM_AGG):
SELECT '{column}' AS col,
       COUNT([{column}]) AS non_nulls,
       CHECKSUM_AGG(CHECKSUM([{column}])) AS hash_agg
FROM   [{schema}].[{table}];
-- POSTGRES (md5 -> first 15 hex -> bigint, summed):
SELECT '{column}' AS col,
       COUNT("{column}") AS non_nulls,
       COALESCE(SUM(('x'||substr(md5("{column}"::text),1,15))::bit(60)::bigint),0) AS hash_agg
FROM   "{schema}"."{table}";
-- NOTE: hashing algorithms differ across engines — prefer count + aggregate parity
-- (below) and keyed-sample comparison for value-level equivalence.

-- ============================================================
-- 3. AGGREGATE PARITY for numeric columns (tolerance-aware)
-- ============================================================
-- SQL SERVER:
SELECT MIN([{column}]), MAX([{column}]), AVG([{column}]), SUM([{column}]) FROM [{schema}].[{table}];
-- POSTGRES:
SELECT MIN("{column}"), MAX("{column}"), AVG("{column}"), SUM("{column}") FROM "{schema}"."{table}";

-- ============================================================
-- 4. KEYED ROW SAMPLE  (spot-check N rows by primary key)
-- ============================================================
-- SQL SERVER:
SELECT TOP {n} {columns} FROM [{schema}].[{table}] ORDER BY {key};
-- POSTGRES:
SELECT {columns} FROM "{schema}"."{table}" ORDER BY {key} LIMIT {n};
