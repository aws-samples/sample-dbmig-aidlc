-- engines/sqlserver-to-mysql/checks/reconcile.sql.tmpl
-- Equivalence checks for the validation phase. TEMPLATES — the validation skill
-- substitutes {schema}, {table}, {column}, {columns}, {key}, {n} per object.
-- Run the SQL SERVER block against the source and the MYSQL block against the
-- target (via the dbmig drivers — pytds / pymysql), then diff the results.

-- ============================================================
-- 1. ROW COUNT  (must match exactly)
-- ============================================================
-- SQL SERVER:
SELECT COUNT(*) FROM [{schema}].[{table}];
-- MYSQL:
SELECT COUNT(*) FROM `{schema}`.`{table}`;

-- ============================================================
-- 2. COLUMN CHECKSUM  (order-independent aggregate per column)
-- ============================================================
-- SQL SERVER:
SELECT '{column}' AS col, COUNT([{column}]) AS non_nulls,
       CHECKSUM_AGG(CHECKSUM([{column}])) AS hash_agg
FROM   [{schema}].[{table}];
-- MYSQL (md5 -> first 15 hex -> integer, summed):
SELECT '{column}' AS col, COUNT(`{column}`) AS non_nulls,
       COALESCE(SUM(CONV(SUBSTRING(MD5(CAST(`{column}` AS CHAR)),1,15),16,10)),0) AS hash_agg
FROM   `{schema}`.`{table}`;
-- NOTE: hashing differs across engines — prefer count + aggregate parity (below)
-- and keyed-sample comparison for value-level equivalence.

-- ============================================================
-- 3. AGGREGATE PARITY for numeric columns (tolerance-aware)
-- ============================================================
-- SQL SERVER:
SELECT MIN([{column}]), MAX([{column}]), AVG([{column}]), SUM([{column}]) FROM [{schema}].[{table}];
-- MYSQL:
SELECT MIN(`{column}`), MAX(`{column}`), AVG(`{column}`), SUM(`{column}`) FROM `{schema}`.`{table}`;

-- ============================================================
-- 4. KEYED ROW SAMPLE  (spot-check N rows by primary key)
-- ============================================================
-- SQL SERVER:
SELECT TOP {n} {columns} FROM [{schema}].[{table}] ORDER BY {key};
-- MYSQL:
SELECT {columns} FROM `{schema}`.`{table}` ORDER BY {key} LIMIT {n};
